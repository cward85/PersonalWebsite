
@model PersonalWebsite.Models.invoiceListVM
@{
    var invoiceGrid = new WebGrid
    (
        source: Model.invoiceEntries,
        canPage: true,
        canSort: true,
        rowsPerPage: 10
    );
}
@Scripts.Render("~/bundles/bootstrap")
<script type="text/javascript">
    function getInvoiceEntry(id) {
        var url = '@Url.Action("ListInvoiceEntries", "Invoice")' + "/" + id;
        $.ajax({
            type: "get",
            url: url,
            async: false,
            success: function (data) {
                var divId = '#ajaxInvoiceEntries';

                $(divId).html(data);
            },
            failure: function () {
                alert("fail");
            }
        });
    }

    $(document).ready(function () {
        if (localStorage.getItem("invoiceId") !== null) {
            getInvoiceEntry(localStorage.getItem("invoiceId"));
            localStorage.removeItem('invoiceId');
        }
        $('#invoiceSubmitButton').click(function (e) {
            e.preventDefault();
            var form = $('#invoiceListForm');

            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                success: function (response) {
                    if (response.success) {
                        // Close modal and redirect or reload
                        $('#addInvoiceModal').modal('hide');
                        if (response.invoiceId !== undefined) {
                            localStorage.setItem("invoiceId", response.invoiceId);
                        }
                        if (response.clientId !== undefined) {
                            localStorage.setItem("clientId", response.clientId);
                        }
                        window.location.href = response.redirectUrl;
                    } else {
                        // Replace the old form container inside the modal with the new one containing validation errors
                        $('#ajaxInvoiceEntries').html(response);

                        // Optional: Re-bind client side validation if using jquery.validate
                        $.validator.unobtrusive.parse('#ajaxInvoiceEntries');
                    }
                }
            });
        });
        
            $("#addInvoiceModal").on("shown.coreui.modal", function () {
                var element = $('#invoiceDatePicker');
                coreui.DatePicker.getOrCreateInstance(element);
                var element2 = $('#invoiceDueDatePicker');
                coreui.DatePicker.getOrCreateInstance(element2);
                // const calendarElementList = Array.prototype.slice.call(document.querySelectorAll('#invoiceDatePicker'))
                // const calendarList = calendarElementList.map(calendarEl => {
                //     alert("bye");
                //     return new coreui.DatePicker(calendarEl)
                // })
            });
        
    });

    function doPreprocessing() {
        $('#invoiceDate').val($('#invoiceDatePicker').find('.date-picker-input').val());
        $('#invoiceDueDate').val($('#invoiceDueDatePicker').find('.date-picker-input').val());
    }

    
</script>

<div class="row">
    <h3>Invoices for @Model.ClientName</h3>
</div>
<div class="row">
    @invoiceGrid.GetHtml(
        tableStyle: "table table-bordered table-striped table-hover",
        headerStyle: "thead-dark grid-action",
        htmlAttributes: new { id = "invoiceTable" },
        columns: invoiceGrid.Columns(
            invoiceGrid.Column("invoiceNumber", header: "Invoice Number", format: (item) => item.invoiceNumber),
            invoiceGrid.Column("invoiceDate", header: "Invoice Date", format: (item) => item.invoiceDate.ToString("MM/dd/yyyy")),
            invoiceGrid.Column("invoiceDueDate", header: "Invoice Due Date", format: (item) => item.invoiceDueDate.ToString("MM/dd/yyyy")),
            invoiceGrid.Column("totalAmount", header: "Total Amount", format: (item) => (item.totalAmount == null ? "$0" : "$" + item.totalAmount)),
            invoiceGrid.Column("sentDate", header: "Invoice Sent Date", format: (item) => item.sentDate == null ? "" : item.sentDate.ToString("MM/dd/yyyy")),
            invoiceGrid.Column(header: "Actions", format: (item) =>
            {
                return Html.Raw(
                         $"<div class='d-flex gap-1'><button onclick='getInvoiceEntry({item.id});return false;' title='View Invoice Entries' class='btn btn-sm btn-primary bi bi-arrow-down'></a></div>"
                      );
            })
        )
    )
</div>
<div class="row">
    @using (Html.BeginForm("AddInvoice", "Invoice", FormMethod.Post, new { enctype = "multipart/form-data", id = "invoiceListForm" }))
    {
        @Html.AntiForgeryToken()
        <div class="p-1 float-end">
            <!-- Button trigger modal -->
            <button type="button" class="btn btn-primary" data-coreui-toggle="modal" data-coreui-target="#addInvoiceModal" title="Add New Invoice">
                Add New Invoice
            </button>
            <!-- Modal -->
            <div class="modal fade" id="addInvoiceModal" tabindex="-1" aria-labelledby="addInvoiceLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="addInvoiceLabel">Add Invoice</h5>
                            <button type="button" class="btn-close" data-coreui-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            @Html.HiddenFor(x => x.clientId)
                            @Html.HiddenFor(x => x.invoiceId)
                            <div class="row">
                                <div class="col-12 col-sm-6 col-md-4 mb-1">
                                    @Html.LabelFor(model => model.invoiceDate, htmlAttributes: new { @class = "form-label required" })

                                    <div class="d-flex justify-content-center">
                                        <div class="border rounded date-picker" data-coreui-locale="en-US" data-coreui-toggle="date-picker" id="invoiceDatePicker"></div>
                                    </div>
                                    @Html.HiddenFor(x => x.invoiceDate)
                                    @Html.ValidationMessageFor(model => model.invoiceDate, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-12 col-sm-6 col-md-4 mb-1">
                                    @Html.LabelFor(model => model.invoiceDueDate, htmlAttributes: new { @class = "form-label required" })
                                    <div class="d-flex justify-content-center">
                                        <div class="border rounded date-picker" data-coreui-locale="en-US" data-coreui-toggle="date-picker" id="invoiceDueDatePicker"></div>
                                    </div>
                                    @Html.HiddenFor(x => x.invoiceDueDate)
                                    @Html.ValidationMessageFor(model => model.invoiceDueDate, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-coreui-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-primary" id="invoiceSubmitButton" onclick="doPreprocessing();">Save</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<div id="ajaxInvoiceEntries">

</div>