@model PersonalWebsite.Models.invoiceEntryListVM
@{
    var invoiceGrid = new WebGrid
    (
        source: Model.invoiceEntries,
        canPage: true,
        canSort: true,
        rowsPerPage: 10
    );
}

<script type="text/javascript">

    $(document).ready(function () {
        $('#invoiceEntrySubmitButton').click(function (e) {
            e.preventDefault();
            var form = $('#invoiceEntryListForm');

            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                success: function (response) {
                    if (response.success) {
                        // Close modal and redirect or reload
                        $('#addInvoiceEntryModal').modal('hide');
                        if (response.invoiceId !== undefined) {
                            localStorage.setItem("invoiceId", response.invoiceId);
                        }
                        if (response.clientId !== undefined) {
                            localStorage.setItem("clientId", response.clientId);
                        }
                        window.location.href = response.redirectUrl;
                    } else {
                        // Replace the old form container inside the modal with the new one containing validation errors
                        $('#ajaxInvoiceEntriesModal').html(response);

                        // Optional: Re-bind client side validation if using jquery.validate
                        $.validator.unobtrusive.parse('#addInvoiceEntryModal');
                    }
                }
            });
        });

        // Bind events on page load
        bindInvoiceEntriesWebGridSortEvents();

        // If using AJAX partial updates, rebind after content reload
        document.addEventListener("ajaxComplete", bindInvoiceEntriesWebGridSortEvents);
    });

function editInvoiceEntry(id) {
    var url = '@Url.Action("GetInvoiceEntry", "Invoice")' + "/" + id;
    $.ajax({
        type: "get",
        url: url,
        async: false,
        success: function (data) {
            var divId = '#ajaxInvoiceEntriesModal';

            $(divId).html(data);
        },
        failure: function () {
            alert("fail");
        }
    });
}

function addInvoiceEntry() {
    var url = '@Url.Action("AddInvoiceEntry", "Invoice")';
    $.ajax({
        type: "get",
        url: url,
        async: false,
        success: function (data) {
            var divId = '#ajaxInvoiceEntriesModal';

            $(divId).html(data);
        },
        failure: function () {
            alert("fail");
        }
   });
}


function bindInvoiceEntriesWebGridSortEvents() {

    // Select all sort links inside the WebGrid
    document.querySelectorAll("#invoiceEntryTable th a").forEach(function (link) {
        link.addEventListener("click", function (e) {
            e.preventDefault();
            // Custom action before sorting          
            var href = $(this).attr('href');
            var queryString = href.indexOf('?') !== -1 ? href.substring(href.indexOf('?') - 1) : '';
            getInvoiceEntry(queryString);

            // Allow the sort to proceed (do not preventDefault unless you handle sorting manually)
        });
    });
}
</script>

<div class="row">
    <h3>Invoice Entries for @Model.invoiceNumber</h3>
</div>
<div class="row">
    @invoiceGrid.GetHtml(
        tableStyle: "table table-bordered table-striped table-hover",
        headerStyle: "thead-dark grid-action",
        htmlAttributes: new { id = "invoiceEntryTable" },
        columns: invoiceGrid.Columns(
            invoiceGrid.Column("Description", header: "Description", format: (item) => item.Description),
            invoiceGrid.Column("Rate", header: "Rate", format: (item) => item.Rate),
            invoiceGrid.Column("RateUnit", header: "Rate Unit", format: (item) => item.RateUnit),
            invoiceGrid.Column("UnitAmount", header: "Unit Amount", format: (item) => item.UnitAmount),
            invoiceGrid.Column("TotalAmount", header: "Total Amount", format: (item) => (item.TotalAmount == null ? "$0" : "$" + item.TotalAmount)),
            invoiceGrid.Column(header: "Actions", format: (item) =>
            {
                return Html.Raw(
                         $"<div class='d-flex gap-1'><button onclick='editInvoiceEntry({item.invoiceEntryId});return false;' title='Edit Invoice Entry' class='btn btn-sm btn-primary bi bi-pencil' data-coreui-toggle='modal' data-coreui-target='#addInvoiceEntryModal'></button></div>"
                      );
            })
        )
    )
</div>
<div class="row">
    @using (Html.BeginForm("AddInvoiceEntry", "Invoice", FormMethod.Post, new { enctype = "multipart/form-data", id = "invoiceEntryListForm" }))
    {
        @Html.AntiForgeryToken()
        <div class="p-1 float-end">
            <!-- Button trigger modal -->
            <button type="button" class="btn btn-primary" data-coreui-toggle="modal" data-coreui-target="#addInvoiceEntryModal" onclick="editInvoiceEntry(0)" title="Add New Invoice Entry">
                Add New Invoice Entry
            </button>
            <!-- Modal -->
            <div class="modal fade" id="addInvoiceEntryModal" tabindex="-1" aria-labelledby="addInvoiceEntryLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="addInvoiceEntryLabel">Add Invoice Entry</h5>
                            <button type="button" class="btn-close" data-coreui-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body" id="ajaxInvoiceEntriesModal">

                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-coreui-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-primary" id="invoiceEntrySubmitButton">Save</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>