@model PersonalWebsite.Models.invoiceEntryListVM
@{
    var invoiceGrid = new WebGrid
    (
        source: Model.invoiceEntries,
        canPage: true,
        canSort: true,
        rowsPerPage: 10
    );
}

<div class="row">
    <h3>Invoice Entries for @Model.invoiceDate.ToString("MM/dd/yyyy")</h3>
</div>
<div class="row">
    @invoiceGrid.GetHtml(
        tableStyle: "table table-bordered table-striped table-hover",
        headerStyle: "thead-dark grid-action",
        htmlAttributes: new { id = "invoiceEntryTable" },
        columns: invoiceGrid.Columns(
            invoiceGrid.Column("Description", header: "Description", format: (item) => item.Description),
            invoiceGrid.Column("Rate", header: "Rate", format: (item) => item.Rate),
            invoiceGrid.Column("RateUnit", header: "Rate Unit", format: (item) => item.RateUnit),
            invoiceGrid.Column("UnitAmount", header: "Unit Amount", format: (item) => item.UnitAmount),
            invoiceGrid.Column("TotalAmount", header: "Total Amount", format: (item) => (item.TotalAmount == null ? "$0" : "$" + item.TotalAmount)),
            invoiceGrid.Column(header: "Actions", format: (item) =>
            {
                return Html.Raw(
                         $"<div class='d-flex gap-1'><button title='View Invoice Entry' class='btn btn-sm btn-primary bi bi-pencil'></a></div>"
                      );
            })
        )
    )
</div>
<div class="row">
    @using (Html.BeginForm("AddInvoiceEntry", "Invoice", FormMethod.Post, new { enctype = "multipart/form-data", id = "invoiceEntryListForm" }))
    {
        @Html.AntiForgeryToken()
        <div class="p-1 float-end">
            <!-- Button trigger modal -->
            <button type="button" class="btn btn-primary" data-coreui-toggle="modal" data-coreui-target="#addInvoiceEntryModal" title="Add New Invoice Entry">
                Add New Invoice Entry
            </button>
            <!-- Modal -->
            <div class="modal fade" id="addInvoiceEntryModal" tabindex="-1" aria-labelledby="addInvoiceEntryLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="addInvoiceEntryLabel">Add Invoice Entry</h5>
                            <button type="button" class="btn-close" data-coreui-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            @Html.HiddenFor(x => x.invoiceId)

                            <div class="row">
                                <div class="col-12 col-sm-6 col-md-3 mb-1">
                                    @Html.LabelFor(model => model.description, htmlAttributes: new { @class = "form-label required" })
                                    @Html.EditorFor(model => model.description, new { htmlAttributes = new { @class = "form-control",  } })
                                    @Html.ValidationMessageFor(model => model.description, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-12 col-sm-6 col-md-3 mb-1">
                                    @Html.LabelFor(model => model.rate, htmlAttributes: new { @class = "form-label required" })
                                    @Html.EditorFor(model => model.rate, new { htmlAttributes = new { @class = "form-control"} })
                                    @Html.ValidationMessageFor(model => model.rate, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-12 col-sm-6 col-md-3 mb-1">
                                    @Html.LabelFor(model => model.rateUnit, htmlAttributes: new { @class = "form-label required" })
                                    @Html.EditorFor(model => model.rateUnit, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.rateUnit, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-12 col-sm-6 col-md-3 mb-1">
                                    @Html.LabelFor(model => model.unitAmount, htmlAttributes: new { @class = "form-label required" })
                                    @Html.EditorFor(model => model.unitAmount, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.unitAmount, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-coreui-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>