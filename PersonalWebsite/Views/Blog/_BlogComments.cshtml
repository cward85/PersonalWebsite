@model PersonalWebsite.Models.blogEntryCommentListVM

@foreach(PersonalWebsite.Models.blogEntryCommentVM comment in Model.comments)
{
    <div class="row">
        <div class="col">
            <span>@comment.comment</span>
        </div>
    </div>
    <div class="row">
        <div class="col text-start">
            <span><b>Author: @comment.displayName </b></span>
        </div>
        <div class="col text-end">
            <span>@comment.commentDate</span>
            @if ((Session["IsAdmin"] != null && (bool)Session["IsAdmin"] == true))
            {
                <button type="button" class="btn btn-primary modalTrashButton bi bi-trash" title="Delete Blog Entry" onclick="deleteComment(@comment.id)"></button>
            }
        </div>
    </div>
    <hr />
}

<div class="row">
    <div class="col-md-3">
        @Html.LabelFor(model => model.displayName, htmlAttributes: new { @class = "form-label modal-text required" })
        @Html.EditorFor(model => model.displayName, new { htmlAttributes = new { @class = "form-control" } })
        <span class="text-danger" id="displayNameError"></span>
    </div>
</div>
<div class="row">
    <div class="col">
        @Html.LabelFor(model => model.comment, htmlAttributes: new { @class = "form-label modal-text required" })
        @Html.TextAreaFor(model => model.comment, new { @class = "form-control", rows = 5 })
        <span class="text-danger" id="commentError"></span>
    </div>
</div>